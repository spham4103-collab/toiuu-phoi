# Cấu hình Supabase cho Máy chủ Node.js cục bộ (server.js) và Script (scripts/setup_auth_users.js)
# Sao chép file này thành ".env" (TUYỆT ĐỐI KHÔNG commit file .env lên Git)

SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Secret key (bắt đầu bằng sb_secret_... trong Project Settings -> API Keys)
# Bắt buộc cho server.js (Fusion 360 Bridge + Local Admin Bridge) và setup_auth_users.js để bypass RLS an toàn
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Tương thích ngược nếu dùng tên biến cũ:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Tùy chọn: Mật khẩu khởi tạo khi chạy "node scripts/setup_auth_users.js"
# ADMIN_INIT_PASSWORD=
# KT1_INIT_PASSWORD=
# THOCNC_INIT_PASSWORD=

PORT=3000
