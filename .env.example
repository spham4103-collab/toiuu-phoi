# Cấu hình Supabase cho Máy chủ Node.js (server.js) và Script Di chuyển dữ liệu (scripts/migrate_to_supabase.js)
# Sao chép file này thành ".env" rồi điền thông tin từ Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Khuyên dùng service_role key cho server.js và migrate_to_supabase.js để bypass RLS khi Fusion 360 đẩy file .IGS
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PORT=3000
